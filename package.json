{
  "name": "3dar-site",
  "private": true,
  "scripts": {
    "build": "npm run build:prismatic && npm run build:ghost && npm run build:hero-dissolve && npm run build:glass && npm run build:blur && npm run build:contact-motion && npm run build:hero-text",
    "build:hero-text": "esbuild components/hero-goo-text.js --bundle --minify --format=iife --outfile=media/bundles/hero-goo-text.js",
    "build:blur": "esbuild components/page-blur-entry.jsx --bundle --minify --jsx=automatic --format=iife --outfile=media/bundles/page-blur.js",
    "build:contact-motion": "esbuild components/contact-motion.js --bundle --minify --format=iife --outfile=media/bundles/contact-motion.js",
    "build:glass": "esbuild components/liquid-glass-entry.jsx --bundle --minify --jsx=automatic --format=iife --outfile=media/bundles/liquid-glass.js",
    "build:hero-dissolve": "esbuild components/hero-dissolve.js --bundle --minify --format=iife --outfile=media/bundles/hero-dissolve.js",
    "build:prismatic": "esbuild components/lightfall-entry.jsx --bundle --minify --jsx=automatic --format=iife --outfile=media/bundles/lightfall.js",
    "build:ghost": "esbuild components/ghost-fibers-entry.js --bundle --minify --format=iife --outfile=media/bundles/ghost-fibers.js"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "liquid-glass-react": "^1.1.1",
    "mathjs": "^15.2.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
